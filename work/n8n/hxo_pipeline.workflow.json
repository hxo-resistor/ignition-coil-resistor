{
  "name": "HXO 全平台发布流水线",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "trigger-schedule",
      "name": "Trigger · Schedule 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1240, 300]
    },
    {
      "parameters": {
        "command": "python work/n8n/n0_discover.py"
      },
      "id": "n0-discover",
      "name": "N0 · Discover new articles",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [-1000, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse the JSON contract emitted on the last line by n0_discover.py\nconst raw = $input.first().json.stdout || '';\nconst lines = raw.trim().split(/\\r?\\n/);\nlet data = { new: [] };\nfor (let i = lines.length - 1; i >= 0; i--) {\n  try { data = JSON.parse(lines[i]); break; } catch (e) {}\n}\nreturn [{ json: { count: (data.new || []).length, new: data.new || [] } }];"
      },
      "id": "n0-parse",
      "name": "Parse Discover JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-780, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-has-new",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-new",
      "name": "IF · has new articles",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-560, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batches",
      "name": "Split In Batches (1 article)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-340, 300]
    },
    {
      "parameters": {
        "command": "python work/n8n/n1_website.py"
      },
      "id": "n1-website",
      "name": "N1 · Website (git push)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [-80, 120],
      "notes": "GitHub Actions build-and-deploy.yml 会自动 Markdown→HTML→Pages。仅 stage content/articles。"
    },
    {
      "parameters": {
        "amount": 120,
        "unit": "seconds"
      },
      "id": "wait-pages",
      "name": "Wait 120s (Pages build)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [140, 120],
      "webhookId": "wait-pages-build",
      "notes": "等待 GitHub Pages 构建完成，URL 才生效"
    },
    {
      "parameters": {
        "command": "python work/n8n/n2_baidu.py --slugs {{ $('Split In Batches (1 article)').item.json.slug }}"
      },
      "id": "n2-baidu",
      "name": "N2 · Baidu push",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [360, 120]
    },
    {
